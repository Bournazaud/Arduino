    {
        "id": "lr_tpl_hero",
        "type": "ui-template",
        "z": "lr_tab",
        "group": "lr_g_patient",
        "page": "",
        "ui": "",
        "name": "Patient (BPM)",
        "order": 1,
        "width": "5",
        "height": "0",
        "head": "",
        "format": "<template>\n  <div v-if=\"msg && msg.payload\" class=\"mon-hero\" :class=\"'mon-st-' + msg.payload.status\">\n    <div class=\"mon-hero-top\">\n      <span class=\"mon-chip\">{{ msg.payload.label }}</span>\n      <span class=\"mon-chip mon-chip-soft\">{{ msg.payload.connText }}</span>\n    </div>\n    <div class=\"mon-hero-mid\">\n      <svg class=\"mon-heart\" :class=\"{ 'mon-heart-beat': msg.payload.beating }\" :style=\"{ animationDuration: msg.payload.beat }\" viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n        <path fill=\"currentColor\" d=\"M12,21.35L10.55,20.03C5.4,15.36 2,12.27 2,8.5C2,5.41 4.42,3 7.5,3C9.24,3 10.91,3.81 12,5.08C13.09,3.81 14.76,3 16.5,3C19.58,3 22,5.41 22,8.5C22,12.27 18.6,15.36 13.45,20.03L12,21.35Z\"/>\n      </svg>\n      <div class=\"mon-bpm\">{{ msg.payload.bpmText }}</div>\n      <div class=\"mon-unit\">BPM</div>\n    </div>\n    <div class=\"mon-hero-msg\">{{ msg.payload.message }}</div>\n  </div>\n  <div v-else class=\"mon-hero mon-st-offline\">\n    <div class=\"mon-hero-msg\">En attente des données de la carte…</div>\n  </div>\n</template>\n\n<style>\n.mon-hero{border-radius:16px;padding:18px 20px;color:#fff;background:linear-gradient(135deg,var(--c1,#64748b),var(--c2,#94a3b8));transition:background .4s}\n.mon-st-normal{--c1:#15803d;--c2:#22c55e}\n.mon-st-bas,.mon-st-haut{--c1:#c2410c;--c2:#ef4444}\n.mon-st-arret{--c1:#7f1d1d;--c2:#dc2626;animation:mon-alarm .8s ease-in-out infinite}\n.mon-st-ambulance{--c1:#0369a1;--c2:#0ea5e9}\n.mon-st-idle{--c1:#334155;--c2:#64748b}\n.mon-st-acq{--c1:#0f766e;--c2:#14b8a6}\n.mon-st-offline{--c1:#6b7280;--c2:#9ca3af}\n.mon-hero-top{display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap}\n.mon-chip{background:rgba(255,255,255,.22);border-radius:999px;padding:4px 14px;font-weight:700;font-size:.95rem;letter-spacing:.3px}\n.mon-chip-soft{font-weight:500;font-size:.8rem;background:rgba(0,0,0,.18)}\n.mon-hero-mid{display:flex;align-items:center;justify-content:center;gap:14px;padding:14px 0 6px}\n.mon-heart{width:64px;height:64px;color:#fff;transform-origin:center}\n.mon-heart-beat{animation:mon-beat 1s ease-in-out infinite}\n.mon-bpm{font-size:5rem;font-weight:800;line-height:1;font-variant-numeric:tabular-nums}\n.mon-unit{font-size:1.1rem;font-weight:600;opacity:.85;align-self:flex-end;padding-bottom:10px}\n.mon-hero-msg{text-align:center;font-size:.95rem;opacity:.95}\n@keyframes mon-beat{0%,100%{transform:scale(1)}15%{transform:scale(1.25)}30%{transform:scale(1)}45%{transform:scale(1.12)}}\n@keyframes mon-alarm{0%,100%{filter:none}50%{filter:brightness(1.4)}}\n</style>\n",
        "storeOutMessages": true,
        "passthru": false,
        "resendOnRefresh": true,
        "templateScope": "local",
