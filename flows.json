    {
        "id": "lr_fn_parse",
        "type": "function",
        "z": "lr_tab",
        "name": "Analyser le message MQTT",
        "func": "// Messages MQTT envoyes par l'Arduino -> evenements pour la fonction \"Etat & decisions\"\n// Topics lus : LR-ambulance/bpm   (nombre, 0 = pas de rythme)\n//              LR-ambulance/etat  (JSON : mode, rec, siren, badge)\n//              LR-ambulance/en_ligne ('on' / 'off', \"testament\" MQTT)\nconst sub = String(msg.topic || '').replace(/^LR-ambulance\\//, '');\nlet p = msg.payload;\nif (Buffer.isBuffer(p)) p = p.toString();\nif (typeof p === 'string') p = p.trim();\n\nif (sub === 'en_ligne') {\n    return { payload: { type: 'conn', value: String(p).toLowerCase() === 'on' } };\n}\nif (sub === 'bpm') {\n    const n = Number(p);\n    if (isNaN(n)) return null;\n    return { payload: n > 0 ? { type: 'bpm', value: Math.round(n) } : { type: 'nobeat' } };\n}\nif (sub === 'etat') {\n    let o = p;\n    if (typeof o === 'string') { try { o = JSON.parse(o); } catch (e) { return null; } }\n    if (!o || typeof o !== 'object') return null;\n    return { payload: { type: 'etat', mode: o.mode, rec: o.rec, siren: o.siren, badge: o.badge } };\n}\nreturn null;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 380,
        "y": 160,
        "wires": [
            [
                "lr_fn_state"
            ]
        ]
    },
    {
        "id": "lr_c2",
        "type": "comment",
        "z": "lr_tab",
        "name": "② Décision : état, alertes, jumeau numérique",
        "info": "",
        "x": 700,
        "y": 90,
        "wires": []
    },
    {
        "id": "lr_fn_state",
        "type": "function",
        "z": "lr_tab",
        "name": "État & décisions (seuils ICI)",
        "func": "// ============ REGLAGES (identiques au code Arduino) ============\nconst SEUIL_BAS  = 50;   // BPM < 50  -> anormal (LED rouge)\nconst SEUIL_HAUT = 80;   // BPM > 80  -> anormal (LED rouge)\nconst MAX_LOG    = 40;   // evenements gardes dans le journal\n// ================================================================\n\nconst ev0 = msg.payload || {};\nconst hhmmss = () => new Date().toLocaleTimeString('fr-FR');\n\nfunction neuf() {\n    return { connected: false, mode: 1, rec: false, got: false, bpm: 0, siren: false,\n             badgeCount: 0, badgeSeen: 0, prevStatus: null,\n             stats: { min: null, max: null, sum: 0, n: 0, alerts: 0 }, log: [] };\n}\nlet S = flow.get('S') || neuf();\n\nconst journal = (level, text) => {\n    S.log.unshift({ t: hhmmss(), level, text });\n    if (S.log.length > MAX_LOG) S.log.length = MAX_LOG;\n};\nconst nouvellesStats = () => ({ min: null, max: null, sum: 0, n: 0, alerts: 0 });\nconst ANORMAL = ['arret', 'bas', 'haut'];\nconst vrai = (v) => (v === true || v === 1 || v === 'true' || v === 'on');\n\nconst bpmStatus = () => {\n    if (!S.rec) return 'none';\n    if (!S.got) return 'acq';\n    if (S.bpm <= 0) return 'arret';\n    if (S.bpm < SEUIL_BAS) return 'bas';\n    if (S.bpm > SEUIL_HAUT) return 'haut';\n    return 'normal';\n};\n\nlet clearChart = false, addPoint = false, toast = null, syncSwitches = false;\n\n// Le message \"etat\" de l'Arduino est compare a l'etat memorise -> evenements\nfunction expand(e) {\n    const out = [];\n    const mode = (e.mode === 'ambulance') ? 0 : 1;\n    const rec = vrai(e.rec), siren = vrai(e.siren);\n    const badge = Number(e.badge) || 0;\n    const scanned = badge > 0 && badge !== S.badgeSeen;\n    S.badgeSeen = badge; S.badgeCount = badge;\n    if (rec !== S.rec)   out.push({ type: 'rec', value: rec, source: scanned ? 'badge' : 'web' });\n    if (mode !== S.mode) out.push({ type: 'mode', value: mode });\n    if (siren !== S.siren) out.push({ type: 'siren', value: siren });\n    return out;\n}\n\nfunction apply(ev) {\n    if (ev.type !== 'bpm' && ev.type !== 'nobeat') syncSwitches = true;\n    switch (ev.type) {\n        case 'init': break;\n\n        case 'conn':\n            if (S.connected !== ev.value) {\n                S.connected = ev.value;\n                journal(ev.value ? 'ok' : 'err', ev.value ? 'Carte Arduino en ligne' : 'Carte Arduino hors ligne');\n                if (!ev.value) { S.rec = false; S.got = false; S.bpm = 0; S.siren = false; S.prevStatus = null; }\n            }\n            break;\n\n        case 'rec':\n            if (ev.value) {\n                S.rec = true; S.got = false; S.bpm = 0; S.prevStatus = null;\n                S.stats = nouvellesStats();\n                journal('ok', ev.source === 'badge' ? 'Badge accepté : enregistrement démarré' : 'Enregistrement démarré (dashboard)');\n                toast = { payload: 'Enregistrement BPM démarré', color: '#16a34a' };\n                clearChart = true;\n            } else {\n                const st = S.stats;\n                journal('info', st.n\n                    ? `Enregistrement terminé : moyenne ${Math.round(st.sum / st.n)} bpm (min ${st.min}, max ${st.max}), ${st.alerts} alerte(s)`\n                    : 'Enregistrement terminé');\n                S.rec = false; S.got = false; S.bpm = 0; S.prevStatus = null;\n                toast = { payload: 'Enregistrement BPM arrêté', color: '#475569' };\n            }\n            break;\n\n        case 'mode':\n            if (S.mode !== ev.value) {\n                S.mode = ev.value; S.prevStatus = null;\n                if (ev.value !== 0) S.siren = false;\n                journal('info', ev.value === 0 ? 'Mode Passage prioritaire (ambulance)' : 'Mode Suivi BPM');\n            }\n            break;\n\n        case 'siren':\n            if (S.siren !== ev.value) {\n                S.siren = ev.value;\n                journal(ev.value ? 'warn' : 'info', ev.value ? 'Sirène activée' : 'Sirène arrêtée');\n            }\n            break;\n\n        case 'bpm':\n        case 'nobeat':\n            if (!S.rec) {   // on a rate le \"demarrage\" : on se resynchronise\n                S.rec = true; S.stats = nouvellesStats();\n                journal('info', 'Enregistrement en cours détecté');\n                syncSwitches = true;\n            }\n            S.bpm = (ev.type === 'bpm') ? ev.value : 0;\n            S.got = true;\n            if (ev.type === 'bpm') {\n                const st = S.stats;\n                st.n++; st.sum += ev.value;\n                st.min = (st.min === null) ? ev.value : Math.min(st.min, ev.value);\n                st.max = (st.max === null) ? ev.value : Math.max(st.max, ev.value);\n            }\n            addPoint = true;\n            break;\n\n        case 'reset':\n            S.stats = nouvellesStats();\n            journal('info', 'Statistiques et graphique réinitialisés');\n            clearChart = true;\n            break;\n    }\n}\n\n// ---------- 1) Mise a jour de l'etat ----------\nconst TYPES = ['init', 'conn', 'rec', 'mode', 'siren', 'bpm', 'nobeat', 'reset', 'etat'];\nif (!TYPES.includes(ev0.type)) return null;\nconst events = (ev0.type === 'etat') ? expand(ev0) : [ev0];\nif (ev0.type === 'etat') syncSwitches = true;\nfor (const e of events) apply(e);\n\n// ---------- 2) Alertes (uniquement en mode BPM, comme sur l'Arduino) ----------\nif (events.some(e => ['bpm', 'nobeat', 'mode', 'rec'].includes(e.type))) {\n    const b = (S.mode === 1 && S.connected) ? bpmStatus() : null;\n    if (b !== S.prevStatus) {\n        if (ANORMAL.includes(b)) {\n            S.stats.alerts++;\n            const txt = b === 'arret' ? 'ARRÊT CARDIAQUE : aucun rythme détecté'\n                      : b === 'bas'   ? `BPM trop bas : ${S.bpm}`\n                                      : `BPM trop élevé : ${S.bpm}`;\n            journal('err', txt);\n            toast = { payload: '⚠ ' + txt, color: '#dc2626' };\n        } else if (b === 'normal' && ANORMAL.includes(S.prevStatus)) {\n            journal('ok', `Retour à la normale : ${S.bpm} bpm`);\n            toast = { payload: `Rythme normal : ${S.bpm} bpm`, color: '#16a34a' };\n        }\n        S.prevStatus = b;\n    }\n}\nflow.set('S', S);\n// ---------- 3) Construction de la vue pour le dashboard ----------\nconst b = bpmStatus();\nlet status, label, message;\nif (!S.connected)      { status = 'offline';   label = 'Carte non connectée'; message = 'La carte n’est pas connectée au broker : vérifiez le WiFi et l’alimentation de l’Arduino.'; }\nelse if (S.mode === 0) { status = 'ambulance'; label = 'Mode Ambulance';      message = S.siren ? 'Passage prioritaire : sirène ACTIVE' : 'Passage prioritaire : sirène au repos'; }\nelse if (b === 'none') { status = 'idle';      label = 'En attente de badge';  message = 'Passez un badge devant le lecteur RFID (ou utilisez l’interrupteur) pour démarrer.'; }\nelse if (b === 'acq')  { status = 'acq';       label = 'Acquisition…';         message = 'Lecture du capteur en cours, restez immobile.'; }\nelse if (b === 'arret'){ status = 'arret';     label = 'ARRÊT CARDIAQUE';      message = 'Aucun rythme détecté par le capteur !'; }\nelse if (b === 'bas')  { status = 'bas';       label = 'Rythme trop bas';      message = `Inférieur à ${SEUIL_BAS} bpm`; }\nelse if (b === 'haut') { status = 'haut';      label = 'Rythme trop élevé';    message = `Supérieur à ${SEUIL_HAUT} bpm`; }\nelse                   { status = 'normal';    label = 'Rythme normal';        message = `Entre ${SEUIL_BAS} et ${SEUIL_HAUT} bpm`; }\n\nconst beating = S.connected && S.rec && S.got && S.bpm > 0;\n\n// Jumeau numerique : ce que fait la carte (memes regles que le code Arduino)\nlet oled = ' ', buzzer = 'silence';\nconst led = { red: 'off', blue: 'off' };\nif (S.connected) {\n    if (S.mode === 0) {\n        oled = 'Passage Prioritaire';\n        if (S.siren) { led.blue = 'alt-a'; led.red = 'alt-b'; buzzer = 'sirène 587 Hz / 440 Hz'; }\n    } else if (!S.rec) {\n        oled = 'En attente badge...';\n    } else if (S.bpm <= 0) {\n        oled = 'ARRET CARDIAQUE'; led.red = 'on'; buzzer = 'alarme continue 300 Hz';\n    } else {\n        oled = 'BPM : ' + S.bpm;\n        const anormal = S.bpm > SEUIL_HAUT || S.bpm < SEUIL_BAS;\n        led[anormal ? 'red' : 'blue'] = 'beat';\n        buzzer = 'bip 500 Hz à chaque battement';\n    }\n}\n\nconst st = S.stats;\nconst view = {\n    status, label, message,\n    connText: S.connected ? 'Carte en ligne (MQTT)' : 'Hors ligne',\n    bpmText: (S.connected && S.rec && S.got) ? String(S.bpm) : '--',\n    beating, beat: beating ? (60 / S.bpm).toFixed(2) + 's' : '1s',\n    oled, led, buzzer, badgeCount: S.badgeCount,\n    stats: {\n        min:  st.min === null ? '—' : st.min,\n        max:  st.max === null ? '—' : st.max,\n        avg:  st.n ? Math.round(st.sum / st.n) : '—',\n        n: st.n, alerts: st.alerts\n    },\n    log: S.log.slice(0, 14)\n};\n\n// ---------- 4) Sorties ----------\nconst out = [{ payload: view }, null, null, null, null, null, null];\nif (clearChart) out[1] = [{ payload: [] }];\nif (addPoint)   out[1] = [{ topic: 'BPM', payload: S.bpm },\n                          { topic: 'Seuil bas',  payload: SEUIL_BAS },\n                          { topic: 'Seuil haut', payload: SEUIL_HAUT }];\nout[2] = { payload: (S.connected && S.rec) ? S.bpm : 0 };\nif (syncSwitches) {\n    out[3] = { payload: S.connected && S.rec };\n    out[4] = { payload: S.connected && S.mode === 0 };\n    out[5] = { payload: S.connected && S.siren };\n}\nif (toast) out[6] = toast;\nreturn out;\n",
        "outputs": 7,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 700,
        "y": 220,
        "wires": [
            [
                "lr_tpl_hero",
                "lr_tpl_board",
                "lr_tpl_stats",
                "lr_tpl_log"
            ],
            [
                "lr_chart"
            ],
            [
                "lr_gauge"
            ],
            [
                "lr_sw_rec"
            ],
            [
                "lr_sw_mode"
            ],
            [
                "lr_sw_siren"
            ],
            [
                "lr_notif"
            ]
        ]
    },
    {
        "id": "lr_c3",
        "type": "comment",
