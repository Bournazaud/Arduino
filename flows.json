    {
        "id": "lr_fn_cmd",
        "type": "function",
        "z": "lr_tab",
        "name": "Commande -> Arduino",
        "func": "// Interrupteurs du dashboard -> commandes MQTT vers l'Arduino\nconst on = (msg.payload === true || msg.payload === 'true' || msg.payload === 1);\nconst P = 'LR-ambulance/';\nswitch (msg.topic) {\n    case 'rec':   return { topic: P + 'rec',      payload: on ? 'on' : 'off' };            // badge virtuel\n    case 'mode':  return { topic: P + 'mode',     payload: on ? 'ambulance' : 'bpm' };     // bouton 2 virtuel\n    case 'siren': return { topic: P + 'bouton1',  payload: on ? 'on' : 'off' };            // bouton 1 virtuel (sirene)\n}\nreturn null;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
