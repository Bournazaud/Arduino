    {
        "id": "lr_tpl_board",
        "type": "ui-template",
        "z": "lr_tab",
        "group": "lr_g_board",
        "page": "",
        "ui": "",
        "name": "Carte (OLED, LED, buzzer)",
        "order": 1,
        "width": "4",
        "height": "0",
        "head": "",
        "format": "<template>\n  <div v-if=\"msg && msg.payload\" class=\"mon-board\">\n    <div class=\"mon-oled\">\n      <div class=\"mon-oled-txt\" :class=\"{ 'mon-oled-alert': msg.payload.status === 'arret' }\">{{ msg.payload.oled }}</div>\n    </div>\n    <div class=\"mon-parts\">\n      <div class=\"mon-part\">\n        <span class=\"mon-led mon-led-blue\" :class=\"'mon-' + msg.payload.led.blue\" :style=\"{ '--beat': msg.payload.beat }\"></span>\n        <small>Bleue · D7</small>\n      </div>\n      <div class=\"mon-part\">\n        <span class=\"mon-led mon-led-red\" :class=\"'mon-' + msg.payload.led.red\" :style=\"{ '--beat': msg.payload.beat }\"></span>\n        <small>Rouge · D5</small>\n      </div>\n      <div class=\"mon-part\">\n        <span :key=\"msg.payload.badgeCount\" class=\"mon-led mon-led-green\" :class=\"{ 'mon-flash': msg.payload.badgeCount > 0 }\"></span>\n        <small>Verte · D6</small>\n      </div>\n    </div>\n    <div class=\"mon-buzzer\">🔊 Buzzer D3 : <b>{{ msg.payload.buzzer }}</b></div>\n    <div class=\"mon-buzzer\">🏷️ Badges RFID lus : <b>{{ msg.payload.badgeCount }}</b></div>\n  </div>\n  <div v-else class=\"mon-board\">En attente de la carte…</div>\n</template>\n\n<style>\n.mon-oled{background:#020617;border:3px solid #1e293b;border-radius:10px;aspect-ratio:2/1;padding:20px 16px;box-shadow:inset 0 0 22px rgba(56,189,248,.28)}\n.mon-oled-txt{font-family:ui-monospace,Menlo,Consolas,monospace;color:#7dd3fc;font-size:1.15rem;letter-spacing:.5px;text-shadow:0 0 6px rgba(125,211,252,.7)}\n.mon-oled-alert{color:#fca5a5;text-shadow:0 0 8px rgba(239,68,68,.9);animation:mon-oledblink .8s steps(2) infinite}\n.mon-parts{display:flex;justify-content:space-around;padding:16px 0 8px}\n.mon-part{display:flex;flex-direction:column;align-items:center;gap:6px}\n.mon-part small{color:#64748b;font-size:.75rem}\n.mon-led{--led:#94a3b8;width:30px;height:30px;border-radius:50%;background:#e2e8f0;border:2px solid #cbd5e1;display:inline-block}\n.mon-led-red{--led:#ef4444}.mon-led-blue{--led:#0ea5e9}.mon-led-green{--led:#22c55e}\n.mon-led.mon-on{background:var(--led);border-color:var(--led);box-shadow:0 0 14px 4px var(--led)}\n.mon-led.mon-beat{animation:mon-ledflash var(--beat,1s) linear infinite}\n.mon-led.mon-alt-a{animation:mon-alta .6s linear infinite}\n.mon-led.mon-alt-b{animation:mon-altb .6s linear infinite}\n.mon-led.mon-flash{animation:mon-ledone .8s linear 1}\n.mon-buzzer{font-size:.9rem;padding:4px 2px;color:#334155}\n@keyframes mon-ledflash{0%,20%{background:var(--led);border-color:var(--led);box-shadow:0 0 14px 4px var(--led)}30%,100%{background:#e2e8f0;border-color:#cbd5e1;box-shadow:none}}\n@keyframes mon-alta{0%,45%{background:var(--led);border-color:var(--led);box-shadow:0 0 14px 4px var(--led)}55%,100%{background:#e2e8f0;border-color:#cbd5e1;box-shadow:none}}\n@keyframes mon-altb{0%,45%{background:#e2e8f0;border-color:#cbd5e1;box-shadow:none}55%,95%{background:var(--led);border-color:var(--led);box-shadow:0 0 14px 4px var(--led)}100%{background:#e2e8f0;border-color:#cbd5e1;box-shadow:none}}\n@keyframes mon-ledone{0%,90%{background:var(--led);border-color:var(--led);box-shadow:0 0 14px 4px var(--led)}100%{background:#e2e8f0;border-color:#cbd5e1;box-shadow:none}}\n@keyframes mon-oledblink{0%{opacity:1}50%{opacity:.25}}\n</style>\n",
